# Copy to .env and fill in. Everything has a safe dev default; the app runs with an empty .env.

DEBUG=true
SECRET_KEY=change-me-in-production
ALLOWED_HOSTS=localhost,127.0.0.1

# Database — leave POSTGRES_DB empty to use SQLite in dev
POSTGRES_DB=
POSTGRES_USER=cbc
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis / Celery
REDIS_URL=redis://localhost:6379/0

# Africa's Talking (SMS) — leave empty to log SMS to console instead of sending
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=

# Claude API — leave empty to generate schemes of work from a local template
# instead of AI. Get a key at https://platform.claude.com/
ANTHROPIC_API_KEY=

# M-Pesa Daraja — leave empty to run payments in sandbox-stub mode
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
DARAJA_SHORTCODE=174379
DARAJA_PASSKEY=
DARAJA_BASE_URL=https://sandbox.safaricom.co.ke
DARAJA_CALLBACK_URL=https://example.com/api/payments/stk-callback/

# Frontend origin(s) allowed to call the API (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
