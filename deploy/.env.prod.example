# Copy to deploy/.env.prod and fill in. Never commit the filled-in file.
#
# Generate SECRET_KEY with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"

# --- The essentials -----------------------------------------------------
SECRET_KEY=replace-with-a-long-random-value

# Your domain once you have one. Until then, use ":80" to smoke-test over HTTP.
# A real hostname makes Caddy fetch an HTTPS certificate automatically.
SITE_ADDRESS=schools.example.com

# Must include the domain the browser uses. Comma-separated, no scheme.
ALLOWED_HOSTS=schools.example.com

# Your frontend origin(s), WITH https://. Drives CORS and CSRF trust.
CORS_ALLOWED_ORIGINS=https://schools.example.com

# Caddy already forces HTTPS, so leave this true with a real domain. Set it to
# false only for a plain-HTTP smoke test (SITE_ADDRESS=:80), or the app will
# redirect to a URL that has no certificate.
SECURE_SSL_REDIRECT=true

# DEBUG must stay false in production (it is the default). Never set it true on
# a live box — it would serve stack traces and settings to any visitor.
DEBUG=false

# The unguessable segment in the M-Pesa callback URL you register with
# Safaricom. Generate with: python -c "import secrets; print(secrets.token_urlsafe(24))"
# Blank closes both payment webhooks — an unconfigured money endpoint credits
# nothing. Register the callback as .../api/payments/stk-callback/<this-value>/
DARAJA_WEBHOOK_SECRET=

# How many sign-in attempts one IP may make per minute (brute-force brake).
LOGIN_THROTTLE_RATE=10/min

# --- Database (kept inside the stack) -----------------------------------
POSTGRES_DB=cbc
POSTGRES_USER=cbc
POSTGRES_PASSWORD=replace-with-a-strong-db-password

# --- Optional real services (blank = stub/sandbox) ----------------------
# Africa's Talking (SMS). Blank => messages are logged, not sent.
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=

# WhatsApp Business Cloud API (Meta). Blank => messages are logged, not sent.
# The school registers its own number at business.facebook.com and gets these.
# WHATSAPP_TEMPLATE is the name of a template Meta has APPROVED with a single
# body variable: without it Meta rejects school-initiated notices to any parent
# who has not messaged the school in the last 24 hours.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE=
WHATSAPP_TEMPLATE_LANG=en

# Claude API for scheme-of-work generation. Blank => local KICD-style template.
ANTHROPIC_API_KEY=

# M-Pesa Daraja. Blank => sandbox-stub mode (no live payments).
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
DARAJA_SHORTCODE=174379
DARAJA_PASSKEY=
DARAJA_BASE_URL=https://sandbox.safaricom.co.ke
DARAJA_CALLBACK_URL=https://schools.example.com/api/payments/stk-callback/
